{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": ["/K"] },
        { "name": "powershell", "cmd": "powershell", "args": ["/K"] }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": ["/K"] },
        { "name": "powershell", "cmd": "powershell", "args": ["/K"] }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": ["/K"] },
        { "name": "powershell", "cmd": "powershell", "args": ["/K"] }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": ["/K"] },
        { "name": "powershell", "cmd": "powershell", "args": ["/K"] }
      ]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}